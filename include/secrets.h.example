#ifndef SECRETS_H
#define SECRETS_H

// ==============================================
// 配置文件模板
// 使用前请将此文件重命名为 secrets.h 并填入真实值
// Rename this file to secrets.h and fill in real values before use
// ==============================================

// Gitee OTA 配置 / Gitee OTA Configuration
#define SECRET_GITEE_TOKEN "your_gitee_token"
#define SECRET_GITEE_USER "your_gitee_username"
#define SECRET_GITEE_REPO "your_repo_name"
#define SECRET_VERSION_URL "https://gitee.com/your_username/your_repo/raw/master/version.json"
#define SECRET_SETTINGONLINE_URL "https://gitee.com/your_username/your_repo/raw/master/settings.json"

// Blinker 物联网平台 / Blinker IoT Platform
#define SECRET_BLINKER_AUTH "your_blinker_auth_key"

// WiFi 配置 / WiFi Configuration
#define SECRET_WIFI_SSID    "your_wifi_ssid"
#define SECRET_WIFI_PASS    "your_wifi_password"

// MAC 地址 / Station MAC Address
#define SECRET_STATION_MAC  {0x00, 0x00, 0x00, 0x00, 0x00, 0x00}

#endif
